<% layout("/layouts/boilerplate") %>

<style>
  .booking-success-wrap {
    max-width: 900px;
    margin: 0 auto;
  }

  .success-card {
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
  }

  .success-card .card-body {
    padding: 2rem;
  }

  .success-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto;
    border-radius: 50%;
    background: #e7f9ee;
    color: #198754;
    display: grid;
    place-items: center;
    font-size: 2rem;
  }

  .booking-confirmation-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .booking-confirmation-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 18px;
  }

  .booking-summary {
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 18px;
    background: #f9fafb;
    overflow: hidden;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }

  .summary-row:last-child {
    border-bottom: 0;
  }

  .summary-row span {
    color: #6b7280;
  }

  .summary-row strong {
    color: #111827;
    text-align: right;
  }

  [data-theme="dark"] .booking-summary {
    background: #1f2937;
    border-color: rgba(255, 255, 255, 0.14);
  }

  [data-theme="dark"] .summary-row {
    border-color: rgba(255, 255, 255, 0.14);
  }

  [data-theme="dark"] .summary-row span,
  [data-theme="dark"] .summary-row strong {
    color: #f3f4f6;
  }

  @media (max-width: 767.98px) {
    .booking-confirmation-grid {
      grid-template-columns: 1fr;
    }

    .success-card .card-body {
      padding: 1.25rem;
    }
  }
</style>

<div class="booking-success-wrap py-5">
  <div class="card border-0 success-card mx-auto">
    <div class="card-body text-center">
      <div class="success-icon mb-3">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <h2 class="mb-2">Booking Confirmed</h2>
      <p class="text-muted mb-4">Your payment is successful and your stay is now confirmed.</p>

      <div class="booking-confirmation-grid text-start">
        <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>" class="booking-confirmation-image">

        <div class="booking-summary">
          <div class="summary-row">
            <span>Property</span>
            <strong><%= booking.listing.title %></strong>
          </div>
          <div class="summary-row">
            <span>Location</span>
            <strong><%= booking.listing.location %></strong>
          </div>
          <div class="summary-row">
            <span>Dates</span>
            <strong><%= booking.checkIn.toDateString() %> to <%= booking.checkOut.toDateString() %></strong>
          </div>
          <div class="summary-row">
            <span>Guests</span>
            <strong><%= booking.guests %></strong>
          </div>
          <div class="summary-row">
            <span>Total paid</span>
            <strong>₹<%= booking.totalPrice.toLocaleString("en-IN") %></strong>
          </div>
          <div class="summary-row">
            <span>Payment status</span>
            <strong class="text-success text-uppercase"><%= booking.paymentStatus %></strong>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
        <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-dark">View listing</a>
        <a href="/listings/orders" class="btn btn-danger">My Orders</a>
        <a href="/listings" class="btn btn-dark">Explore more</a>
      </div>
    </div>
  </div>
</div>
