<% layout("/layouts/boilerplate") %>

<div class="auth-page">

    <div class="auth-container">

        <!-- Left Travel Section -->
        <div class="auth-visual login-visual">

            <div class="auth-overlay"></div>

            <div class="auth-brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-key"></i>
                </div>

                <h1>WanderNest</h1>

                <p>
                    Secure your account.
                    <br>
                    Continue your journey safely.
                </p>

            </div>

            <div class="travel-badge">

                <i class="fa-solid fa-shield-halved"></i>

                Secure password recovery

            </div>

        </div>


        <!-- Change Password Form -->
        <div class="auth-form-section">

            <div class="auth-form-wrapper">

                <!-- Mobile Brand -->
                <div class="mobile-brand">

                    <div class="brand-icon">
                        <i class="fa-solid fa-key"></i>
                    </div>

                    <span>WanderNest</span>

                </div>


                <!-- Heading -->
                <div class="auth-heading">

                    <span class="auth-small-title">
                        Account Recovery
                    </span>

                    <h2>Reset your password</h2>

                    <p>
                        Verify your old password and create a new one.
                    </p>

                </div>


                <form
                    action="/forgot-password"
                    method="POST"
                    class="auth-form"
                    id="forgotPasswordForm"
                >

                    <!-- Username / Email -->
                    <div class="auth-input-group">

                        <label for="identifier">
                            Username or Email
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="fa-regular fa-user"></i>

                            <input
                                type="text"
                                name="identifier"
                                id="identifier"
                                placeholder="Enter username or email"
                                required
                            >

                        </div>

                    </div>


                    <!-- Old Password -->
                    <div class="auth-input-group">

                        <label for="oldPassword">
                            Old Password
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="fa-solid fa-lock"></i>

                            <input
                                type="password"
                                name="oldPassword"
                                id="oldPassword"
                                placeholder="Enter your old password"
                                required
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                onclick="togglePassword('oldPassword', this)"
                            >
                                <i class="fa-regular fa-eye"></i>
                            </button>

                        </div>

                    </div>


                    <!-- New Password -->
                    <div class="auth-input-group">

                        <label for="newPassword">
                            New Password
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="fa-solid fa-lock"></i>

                            <input
                                type="password"
                                name="newPassword"
                                id="newPassword"
                                placeholder="Enter new password"
                                required
                                minlength="6"
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                onclick="togglePassword('newPassword', this)"
                            >
                                <i class="fa-regular fa-eye"></i>
                            </button>

                        </div>

                        <!-- New Password Strength -->
                        <div
                            id="recovery-password-strength"
                            class="password-strength"
                        >
                            <span id="recovery-password-strength-text"></span>
                        </div>

                    </div>


                    <!-- Confirm New Password -->
                    <div class="auth-input-group">

                        <label for="confirmPassword">
                            Confirm New Password
                        </label>

                        <div class="auth-input-wrapper">

                            <i class="fa-solid fa-lock"></i>

                            <input
                                type="password"
                                name="confirmPassword"
                                id="confirmPassword"
                                placeholder="Enter new password again"
                                required
                                minlength="6"
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                onclick="togglePassword('confirmPassword', this)"
                            >
                                <i class="fa-regular fa-eye"></i>
                            </button>

                        </div>

                        <div
                            id="password-match-message"
                            class="password-match-message"
                        ></div>

                    </div>


                    <!-- Update Button -->
                    <button
                        type="submit"
                        class="auth-submit-btn"
                    >

                        <span>Update Password</span>

                        <i class="fa-solid fa-check"></i>

                    </button>

                </form>


                <!-- Back to Login -->
                <div class="auth-switch">

                    <a href="/login">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Login
                    </a>

                </div>


                <div class="auth-divider">
                    <span>WanderNest</span>
                </div>

                <p class="auth-footer-text">
                    Your journey. Your account. Your security.
                </p>

            </div>

        </div>

    </div>

</div>


<script>


// =========================================================
// SHOW / HIDE PASSWORD
// =========================================================

function togglePassword(inputId, button) {

    const input = document.getElementById(inputId);

    const icon = button.querySelector("i");


    if (input.type === "password") {

        input.type = "text";

        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");

    } else {

        input.type = "password";

        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");

    }

}


// =========================================================
// NEW PASSWORD STRENGTH
// =========================================================

const newPassword =
    document.getElementById("newPassword");

const strengthBox =
    document.getElementById(
        "recovery-password-strength"
    );

const strengthText =
    document.getElementById(
        "recovery-password-strength-text"
    );


newPassword.addEventListener("input", function () {

    const password = this.value;


    if (password.length === 0) {

        strengthText.textContent = "";

        strengthBox.className =
            "password-strength";

        return;
    }


    if (password.length < 6) {

        strengthText.textContent =
            "Weak Password";

        strengthBox.className =
            "password-strength weak";

        return;
    }


    const hasUppercase =
        /[A-Z]/.test(password);

    const hasLowercase =
        /[a-z]/.test(password);

    const hasNumber =
        /[0-9]/.test(password);

    const hasSpecial =
        /[^A-Za-z0-9]/.test(password);


    if (
        hasUppercase &&
        hasLowercase &&
        hasNumber &&
        hasSpecial
    ) {

        strengthText.textContent =
            "Strong Password";

        strengthBox.className =
            "password-strength strong";

    } else {

        strengthText.textContent =
            "Medium Password";

        strengthBox.className =
            "password-strength medium";

    }

});


// =========================================================
// PASSWORD MATCH
// =========================================================

const confirmPassword =
    document.getElementById("confirmPassword");

const matchMessage =
    document.getElementById(
        "password-match-message"
    );


function checkPasswordMatch() {

    if (confirmPassword.value.length === 0) {

        matchMessage.textContent = "";

        return true;
    }


    if (
        newPassword.value !==
        confirmPassword.value
    ) {

        matchMessage.textContent =
            "Passwords do not match";

        matchMessage.className =
            "password-match-message mismatch";

        return false;

    }


    matchMessage.textContent =
        "Passwords match";

    matchMessage.className =
        "password-match-message matched";

    return true;
}


confirmPassword.addEventListener(
    "input",
    checkPasswordMatch
);

newPassword.addEventListener(
    "input",
    checkPasswordMatch
);


// =========================================================
// FORM VALIDATION
// =========================================================

document
    .getElementById("forgotPasswordForm")
    .addEventListener("submit", function (event) {

        const password =
            newPassword.value;

        const confirm =
            confirmPassword.value;


        // Minimum length

        if (password.length < 6) {

            event.preventDefault();

            strengthText.textContent =
                "Weak Password";

            strengthBox.className =
                "password-strength weak";

            newPassword.focus();

            return;
        }


        // Password match

        if (password !== confirm) {

            event.preventDefault();

            matchMessage.textContent =
                "Passwords do not match";

            matchMessage.className =
                "password-match-message mismatch";

            confirmPassword.focus();

            return;
        }

    });

</script>